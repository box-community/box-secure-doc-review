# Copy this file to .env and fill in your real values.
# Find these in the Box Developer Console: https://cloud.app.box.com/developers/console

# CCG app credentials (Configuration tab)
BOX_CLIENT_ID=your_client_id
BOX_CLIENT_SECRET=your_client_secret

# Your enterprise ID (account icon > Copy Enterprise ID)
BOX_ENTERPRISE_ID=your_enterprise_id

# Folder uploaded documents land in.
# 0 = the Service Account's root folder (fine for getting started).
# For real use, create a folder (e.g. per loan application) and use its ID.
LOAN_DOCS_FOLDER_ID=0
